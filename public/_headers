# BAAC Field Route — cache control
# =====================

# Stable library files (Leaflet, Lucide, MarkerCluster) — cache aggressively
/lib/*
  Cache-Control: public, max-age=31536000, immutable

# App shell + SW must NEVER be cached (stale SW caused old UI after deploys)
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/admin.html
  Cache-Control: no-cache, no-store, must-revalidate
/admin
  Cache-Control: no-cache, no-store, must-revalidate
# JS/CSS ทุกไฟล์ที่เว็บโหลดต้องมี ?v= เสมอ (เปลี่ยนเลข = URL ใหม่ = ได้ของใหม่ทันที) — ห้ามอ้างไฟล์เปล่าไม่มี ?v=
/js/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable
/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

# Data files must always be fresh from the server (server-authoritative GPS).
/customers-db.json
  Cache-Control: no-cache, no-store, must-revalidate
/debt-data.json
  Cache-Control: no-cache, no-store, must-revalidate
/fuel-prices.json
  Cache-Control: no-cache, no-store, must-revalidate
/version.json
  Cache-Control: no-cache, no-store, must-revalidate

# CORS for API routes — เฟส 4: ล็อกเฉพาะเว็บตัวเอง (เดิม * = เว็บไหนในโลกก็เรียกได้)
# แอปเรียกแบบ same-origin ทั้งหมด (API.baseUrl = location.origin) จึงไม่กระทบใช้งาน
/api/*
  Access-Control-Allow-Origin: https://baacroute.shop
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization
  Access-Control-Max-Age: 86400

# Security hardening (global)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
