#!/usr/bin/env bash
# pre-commit: เว็บตัวอย่างต้องตรงกับเว็บจริงเสมอ
# ทำงานเฉพาะเมื่อมีการแก้ UI ของเว็บหลัก (index.html / css / js) ในชุดที่ commit
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

STAGED=$(git diff --cached --name-only)
if ! echo "$STAGED" | grep -qE '^public/(index\.html|css/|js/)'; then
  exit 0
fi

echo "🏷️  stamp assets (content hash)..."
python3 scripts/stamp-assets.py >/tmp/bfr-stamp.log 2>&1 && tail -1 /tmp/bfr-stamp.log
git add public/index.html

echo "🔄 build-demo: ซิงก์เว็บตัวอย่างกับเว็บจริง..."
if ! python3 scripts/build-demo.py >/tmp/bfr-build-demo.log 2>&1; then
  echo "❌ build-demo ล้มเหลว — ดู /tmp/bfr-build-demo.log"
  exit 1
fi
tail -2 /tmp/bfr-build-demo.log
git add public/demo/index.html

if ! python3 scripts/build-demo.py --check; then
  echo "❌ demo ยังไม่ตรงกับเว็บจริง — หยุด commit"
  exit 1
fi
echo "✅ demo ตรงกับเว็บจริงแล้ว (commit พร้อมกัน)"
